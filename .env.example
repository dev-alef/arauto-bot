# ──────────────────────────────────────────────
#  WhatsApp AI Bot — Variáveis de Ambiente
#  Copie este arquivo como .env e preencha os valores
# ──────────────────────────────────────────────

# ── GOOGLE GEMINI ─────────────────────────────
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=sua-chave-do-gemini
GEMINI_MODEL=gemini-2.5-flash

# ── EVOLUTION API (WhatsApp) ───────────────────
# URL onde sua Evolution API está rodando
EVOLUTION_URL=http://localhost:8080

# Chave da API (definida na instalação da Evolution API)
EVOLUTION_API_KEY=sua-api-key-da-evolution

# Nome da instância criada na Evolution API
EVOLUTION_INSTANCE=minha-instancia

# ── GRUPO DESTINO ──────────────────────────────
# ID do grupo WhatsApp destino
# Como descobrir: use a rota GET /group/fetchAllGroups/{instance} da Evolution API
# Formato: 55219XXXXXXXX-XXXXXXXXXX@g.us
TARGET_GROUP_ID=SEU_GRUPO_ID@g.us

# ── FILTRO DE ORIGEM (opcional) ───────────────
# Número que será monitorado. Deixe vazio para monitorar todos.
# Formato com DDI: 5521912345678
WATCH_NUMBER=

# ── AULAS DO CURSO DE INTELIGÊNCIA ARTIFICIAL ────
# Grupo exclusivo das aulas de IA (tem prioridade sobre o número privado).
IA_TARGET_GROUP_ID=
# Alternativa: contato privado, com DDI e DDD, somente dígitos.
# Se nenhum destino for válido, a aula é ignorada.
IA_TARGET_NUMBER=
# Remetente autorizado das aulas; se vazio, usa WATCH_NUMBER.
IA_WATCH_NUMBER=

# ── SPEECHMA ──────────────────────────────────
# Voz padrão para geração de áudio
# Opções PT-BR: pt-BR-AntonioNeural, pt-BR-FranciscaNeural, pt-BR-BrendaNeural
SPEECHMA_VOICE=pt-BR-AntonioNeural
# true: envia texto + áudio; false: somente texto, nos dois destinos
AUDIO_ENABLED=true

# ── SERVIDOR ──────────────────────────────────
PORT=3000

# Token de segurança para o webhook (configure o mesmo na Evolution API)
WEBHOOK_TOKEN=meu-token-secreto-troque-isso

# ── PERSONALIZAÇÃO DA IA ───────────────────────
# Instrução de como adaptar o texto (pode ser personalizada)
AI_PROMPT=Adapte esta mensagem para um tom mais formal e profissional, mantendo o conteúdo original. Retorne apenas o texto adaptado, sem explicações:
